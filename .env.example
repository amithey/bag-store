# Public site URL — used for SEO canonical links, OpenGraph share previews
# and JSON-LD. Set to the real domain in production, e.g. https://smadarheymans.co.il
NEXT_PUBLIC_SITE_URL=

# Email provider option 1: Gmail SMTP.
# Recommended while Resend is not connected to a verified domain.
# Create a Gmail App Password and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Email provider option 2: https://resend.com
# Works fully only after verifying a sender domain in Resend.
RESEND_API_KEY=

# Recommended: use a verified sender domain/address in Resend.
# Example: "smadar heymans <orders@your-domain.com>"
ORDER_FROM_EMAIL=

# Optional future Bit payment link.
# When set, the order success screen and customer email will include this link.
BIT_PAYMENT_URL=

# Supabase products/admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional automatic WhatsApp alert via Meta WhatsApp Cloud API.
# Without these values, orders still work and users still get a WhatsApp link.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Store owner phone in international format, without +.
# Example for 050-781-0050: 972507810050
WHATSAPP_ALERT_TO=972507810050
